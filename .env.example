DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ─── SMS Provider ───────────────────────────────────────────────────────────
# Pick the active provider: SSL_WIRELESS | GP | ROBI | BANGLALINK | GENERIC_HTTP
SMS_PROVIDER="SSL_WIRELESS"
# Until a provider's env vars are set, messages are stored as DRAFT/QUEUED
# (no live send) so the dashboard, queue, retry, and reports still work end-to-end.

# SSL Wireless (sms.sslwireless.com)
SSL_SMS_BASE_URL="https://sms.sslwireless.com/api/v3/send-sms"
SSL_SMS_API_TOKEN=""
SSL_SMS_SID=""

# Robi Bulk SMS
ROBI_SMS_BASE_URL=""
ROBI_SMS_API_KEY=""
ROBI_SMS_SENDER_ID="SchoolSMS"

# Banglalink Bulk SMS
BANGLALINK_SMS_BASE_URL=""
BANGLALINK_SMS_API_KEY=""
BANGLALINK_SMS_SENDER_ID=""

# Grameenphone enterprise SMS
GP_SMS_BASE_URL=""
GP_SMS_CLIENT_ID=""
GP_SMS_CLIENT_SECRET=""
GP_SMS_SENDER_ID="SchoolSMS"

# Generic HTTP gateway (fallback for any REST SMS provider)
SMS_HTTP_BASE_URL=""
SMS_HTTP_API_KEY=""
SMS_HTTP_SENDER_ID="SchoolSMS"

# ─── Payment Gateway ──────────────────────────────────────────────────────────
# Each gateway is enabled by setting its env vars. Unconfigured gateways report
# "not configured" and payments via them return a clear error instead of
# attempting a live charge. Webhook secrets are required for HMAC verification.

# bKash — Tokenized Checkout
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_WEBHOOK_SECRET=""

# Nagad — RSA-signed checkout (PEM-formatted keys)
NAGAD_BASE_URL="https://api-qa.nagad.com/api/dfs"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_WEBHOOK_SECRET=""

# Rocket (DBBL) merchant API
ROCKET_BASE_URL=""
ROCKET_MERCHANT_ID=""
ROCKET_API_KEY=""
ROCKET_WEBHOOK_SECRET=""

# SSLCommerz — hosted checkout
SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_WEBHOOK_SECRET=""

