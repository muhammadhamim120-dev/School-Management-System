# Production environment — PUBLIC client-side config only.
#
# These NEXT_PUBLIC_* values are inlined into the browser bundle at build time
# and are therefore public by design (every visitor can read them in the JS).
# They are committed so Vercel picks them up automatically at build.
#
# Do NOT put server-side secrets (DATABASE_URL, VAPI_PRIVATE_KEY, auth secrets,
# etc.) in this file — those belong in Vercel Project Settings only.

# Vapi AI voice widget (public key + assistant id — both client-safe)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=db065474-ac9a-4cac-81dd-f14799e54959
NEXT_PUBLIC_VAPI_ASSISTANT_ID=9cb3d7dc-f3be-4337-afd1-ead28e04d7da
