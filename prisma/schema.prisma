// Prisma schema for School Management System — Multi-Tenant SaaS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- SaaS & Multi-Tenancy ----------
enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
}

// ---------- Auth ----------
enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ADMIN
  TEACHER
  STAFF
  PARENT
  STUDENT
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceMethod {
  MANUAL
  QR
  RFID
  FINGERPRINT
}

enum FeeStatus {
  PAID
  UNPAID
  PARTIAL
  OVERDUE
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// ---------- Academic structure (Bangladesh) ----------
enum Medium {
  BANGLA
  ENGLISH
  MADRASA
}

enum MadrasaLevel {
  EBTEDAYEE
  DAKHIL
  ALIM
}

enum Shift {
  MORNING
  DAY
  EVENING
}

enum BoardExam {
  PEC
  JSC
  SSC
  HSC
  EBTEDAYEE
  DAKHIL
  ALIM
}

enum BoardRegStatus {
  PENDING
  REGISTERED
  APPROVED
  REJECTED
}

// ---------- Finance ----------
enum FeeType {
  TUITION
  ADMISSION
  EXAM
  TRANSPORT
  HOSTEL
  COACHING
  LIBRARY
  OTHER
}

enum FeeRecurrence {
  ONE_TIME
  MONTHLY
  TERM
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentGateway {
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
}

enum PaymentEvent {
  INITIATE
  CALLBACK
  WEBHOOK
  VERIFY
  REFUND
  MANUAL
}

enum ConcessionType {
  DISCOUNT
  SCHOLARSHIP
  WAIVER
}

enum ConcessionMode {
  PERCENTAGE
  FIXED
}

// ---------- Library ----------
enum CopyStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  RESERVED
}

enum LoanStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

enum BorrowerType {
  STUDENT
  TEACHER
}

// ---------- Transport ----------
enum VehicleType {
  BUS
  MINIBUS
  VAN
  CAR
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum TransportAssignmentStatus {
  ACTIVE
  CANCELLED
}

// ---------- Hostel ----------
enum RoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
}

enum AllocationStatus {
  ACTIVE
  VACATED
}

// ---------- SMS ----------
enum SmsStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
}

enum SmsCategory {
  GENERAL
  ATTENDANCE
  FEE_REMINDER
  RESULT
  HOLIDAY
  EMERGENCY
  ADMISSION
  OTP
}

enum SmsAudience {
  ALL
  STUDENTS
  PARENTS
  TEACHERS
  CUSTOM
}

// ---------- Admissions ----------
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ADMITTED
  REJECTED
  WAITLISTED
}

// ---------- AI Dropout Risk ----------
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ---------- Homework ----------
enum HomeworkSubmissionStatus {
  SUBMITTED
  GRADED
  LATE
  RETURNED
}

// ---------- Online Examination ----------
enum QuestionType {
  MCQ
  WRITTEN
}

enum OnlineExamStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TIMED_OUT
}

// ---------- Certificates ----------
enum CertificateType {
  TRANSFER
  CHARACTER
  BONAFIDE
  MARKSHEET
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

// ============================================================
// SaaS INFRASTRUCTURE MODELS
// ============================================================

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  customDomain  String?   @unique
  email         String
  phone         String?
  address       String?
  logo          String?
  favicon       String?
  timezone      String    @default("Asia/Dhaka")
  currency      String    @default("BDT")
  locale        String    @default("en")
  status        OrgStatus @default(PENDING_SETUP)
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  settings        Setting?
  users           User[]
  subscription    Subscription?
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[]

  @@index([slug])
  @@index([status])
}

model Subscription {
  id                String             @id @default(cuid())
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String             @unique
  tier              PlanTier           @default(FREE)
  status            SubscriptionStatus @default(TRIAL)
  maxStudents       Int                @default(100)
  maxTeachers       Int                @default(20)
  maxStorageMb      Int                @default(500)
  features          Json?
  monthlyPrice      Float              @default(0)
  billingEmail      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tier])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  schoolId    String?
  organization Organization? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FeatureFlag {
  id           String   @id @default(cuid())
  key          String   @unique
  description  String?
  defaultValue Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupportTicket {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  subject        String
  description    String
  status         String       @default("OPEN")
  priority       String       @default("MEDIUM")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ============================================================
// AUTH & CORE MODELS (with schoolId)
// ============================================================

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String
  password        String
  role            Role          @default(ADMIN)
  image           String?
  emailVerified   DateTime?
  resetToken      String?
  resetTokenExpiry DateTime?
  schoolId        String?
  organization    Organization? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([email, schoolId])
  @@index([schoolId])
}

// ---------- Core academic ----------
model Class {
  id        String    @id @default(cuid())
  name      String
  capacity  Int       @default(40)
  medium    Medium?
  shift     Shift?
  campus    Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  campusId  String?
  session   AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId String?
  schoolId  String?
  sections  Section[]
  students  Student[]
  subjects  Subject[]
  exams     Exam[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  routineSlots RoutineSlot[]
  homeworks    Homework[]
  onlineExams  OnlineExam[]
  questions    Question[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id        String    @id @default(cuid())
  name      String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  shift     Shift?
  schoolId  String?
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([classId, name])
  @@index([schoolId])
  routineSlots RoutineSlot[]
  homeworks    Homework[]
  onlineExams  OnlineExam[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String
  class       Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId     String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId   String?
  schoolId    String?
  results     Result[]
  coachingBatches CoachingBatch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  routineSlots RoutineSlot[]
  homeworks    Homework[]
  questions    Question[]
  onlineExams  OnlineExam[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// ---------- People ----------
model Student {
  id               String       @id @default(cuid())
  studentId        String
  fullName         String
  photo            String?
  gender           Gender
  dateOfBirth      DateTime
  bloodGroup       String?
  phone            String?
  email            String?
  address          String?
  class            Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId          String?
  section          Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId        String?
  rollNumber       String?
  admissionDate    DateTime     @default(now())
  guardianName     String?
  parent           Parent?      @relation(fields: [parentId], references: [id], onDelete: SetNull)
  parentId         String?
  emergencyContact String?
  status           Status       @default(ACTIVE)
  medium           Medium?
  madrasaLevel     MadrasaLevel?
  shift            Shift?
  campus           Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  campusId         String?
  session          AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId        String?
  schoolId         String?
  attendance       Attendance[]
  results          Result[]
  fees             Fee[]
  boardRegistrations BoardRegistration[]
  invoices         Invoice[]
  concessions      Concession[]
  bookLoans        BookLoan[]
  transport        StudentTransport[]
  hostelAllocations HostelAllocation[]
  riskAssessments  RiskAssessment[]
  batchEnrollments BatchEnrollment[]
  batchAttendance  BatchAttendance[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  parentMessages ParentMessage[]
  leaveRequests  LeaveRequest[]
  examAttempts   ExamAttempt[]
  homeworkSubmissions HomeworkSubmission[]
  certificates   Certificate[]

  @@unique([schoolId, studentId])
  @@index([schoolId])
}

model Teacher {
  id            String    @id @default(cuid())
  teacherId     String
  fullName      String
  photo         String?
  department    String?
  subject       String?
  qualification String?
  experience    Int?      @default(0)
  phone         String?
  email         String?
  address       String?
  joiningDate   DateTime  @default(now())
  salary        Float?    @default(0)
  status        Status    @default(ACTIVE)
  shift         Shift?
  campus        Campus?   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  campusId      String?
  schoolId      String?
  subjects      Subject[]
  bookLoans     BookLoan[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  routineSlots RoutineSlot[]
  homeworks    Homework[]
  questions    Question[]
  onlineExams  OnlineExam[]
  parentMessages ParentMessage[]
  teacherAttendance TeacherAttendance[]
  coachingBatches CoachingBatch[]

  @@unique([schoolId, teacherId])
  @@index([schoolId])
}

model Parent {
  id               String    @id @default(cuid())
  parentId         String
  fullName         String
  photo            String?
  phone            String?
  email            String?
  address          String?
  occupation       String?
  emergencyContact String?
  schoolId         String?
  students         Student[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([schoolId, parentId])
  @@index([schoolId])
}

// ---------- Operations ----------
model Attendance {
  id          String           @id @default(cuid())
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  remark      String?
  checkInTime DateTime?
  method      AttendanceMethod @default(MANUAL)
  recordedBy  String?
  schoolId    String?
  createdAt   DateTime         @default(now())

  @@unique([studentId, date])
  @@index([date])
  @@index([method])
  @@index([schoolId])
}

model TeacherAttendance {
  id          String           @id @default(cuid())
  teacher     Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  remark      String?
  checkInTime DateTime?
  method      AttendanceMethod @default(MANUAL)
  recordedBy  String?
  schoolId    String?
  createdAt   DateTime         @default(now())

  @@unique([teacherId, date])
  @@index([date])
  @@index([method])
  @@index([schoolId])
}

// ---------- Coaching ----------
model CoachingBatch {
  id          String           @id @default(cuid())
  name        String
  subject     Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId   String?
  teacher     Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId   String?
  capacity    Int              @default(30)
  monthlyFee  Float            @default(0)
  room        String?
  schedule    String?
  status      String           @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  schoolId    String?
  enrollments BatchEnrollment[]
  attendance  BatchAttendance[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([subjectId])
  @@index([teacherId])
  @@index([status])
  @@index([schoolId])
}

model BatchEnrollment {
  id         String        @id @default(cuid())
  batch      CoachingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId    String
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  enrolledAt DateTime      @default(now())
  status     String        @default("ACTIVE")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([batchId, studentId])
  @@index([studentId])
}

model BatchAttendance {
  id        String           @id @default(cuid())
  batch     CoachingBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId   String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remark    String?
  createdAt DateTime         @default(now())

  @@unique([batchId, studentId, date])
  @@index([batchId, date])
}

model Exam {
  id        String   @id @default(cuid())
  name      String
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId   String?
  startDate DateTime
  endDate   DateTime
  schoolId  String?
  results   Result[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Result {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId      String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   String
  marks       Float
  totalMarks  Float    @default(100)
  grade       String?
  createdAt   DateTime @default(now())

  @@unique([studentId, examId, subjectId])
}

model Fee {
  id          String    @id @default(cuid())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  title       String
  amount      Float
  paidAmount  Float     @default(0)
  dueDate     DateTime
  status      FeeStatus @default(UNPAID)
  schoolId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  audience  String   @default("ALL")
  pinned    Boolean  @default(false)
  schoolId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(UPCOMING)
  schoolId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([schoolId])
}

// ---------- Academic structure models ----------
model Campus {
  id        String    @id @default(cuid())
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean   @default(false)
  schoolId  String?
  classes   Class[]
  students  Student[]
  teachers  Teacher[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
}

model AcademicSession {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  schoolId  String?
  terms     Term[]
  classes   Class[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id        String          @id @default(cuid())
  name      String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  schoolId  String?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, name])
  @@index([schoolId])
}

model BoardRegistration {
  id           String         @id @default(cuid())
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  boardExam    BoardExam
  regNumber    String?
  rollNumber   String?
  examYear     Int
  boardName    String?
  status       BoardRegStatus @default(PENDING)
  schoolId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([studentId, boardExam, examYear])
  @@index([schoolId])
}

// ---------- Finance models ----------
model FeeCategory {
  id          String        @id @default(cuid())
  name        String
  type        FeeType
  recurrence  FeeRecurrence @default(ONE_TIME)
  description String?
  isActive    Boolean       @default(true)
  schoolId    String?
  structures  FeeStructure[]
  invoiceItems InvoiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model FeeStructure {
  id          String       @id @default(cuid())
  category    FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  amount      Float
  classId     String?
  sessionId   String?
  shift       Shift?
  label       String?
  isActive    Boolean      @default(true)
  schoolId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([schoolId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNo     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  period        String?
  subtotal      Float         @default(0)
  discountTotal Float         @default(0)
  total         Float         @default(0)
  paidTotal     Float         @default(0)
  notes         String?
  schoolId      String?
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([schoolId, invoiceNo])
  @@index([studentId])
  @@index([status])
  @@index([schoolId])
}

model InvoiceItem {
  id          String       @id @default(cuid())
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  category    FeeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  description String
  amount      Float
  discount    Float        @default(0)
  createdAt   DateTime     @default(now())

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  amount         Float
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(SUCCESS)
  gateway        PaymentGateway?
  gatewayRef     String?
  receivedAt     DateTime      @default(now())
  note           String?
  refundedAmount Float         @default(0)
  refundedAt     DateTime?
  refundRef      String?
  schoolId       String?
  transactions   PaymentTransaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([gatewayRef])
  @@index([schoolId])
}

model PaymentTransaction {
  id         String         @id @default(cuid())
  payment    Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId  String?
  invoiceId  String?
  gateway    PaymentGateway?
  gatewayRef String?
  event      PaymentEvent
  status     PaymentStatus  @default(PENDING)
  amount     Float?
  payload    String?
  message    String?
  createdAt  DateTime       @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@index([gatewayRef])
  @@index([event])
}

model Concession {
  id          String         @id @default(cuid())
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  type        ConcessionType
  mode        ConcessionMode @default(PERCENTAGE)
  value       Float
  reason      String?
  isActive    Boolean        @default(true)
  schoolId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId])
  @@index([schoolId])
}

// ---------- Library models ----------
model BookCategory {
  id        String   @id @default(cuid())
  name      String
  schoolId  String?
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Author {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  schoolId  String?
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Publisher {
  id        String   @id @default(cuid())
  name      String
  schoolId  String?
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Book {
  id          String        @id @default(cuid())
  title       String
  isbn        String?
  category    BookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  author      Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  publisher   Publisher?    @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  publisherId String?
  edition     String?
  publishYear Int?
  language    String?
  shelf       String?
  rack        String?
  description String?
  coverUrl    String?
  schoolId    String?
  copies      BookCopy[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([title])
  @@index([schoolId])
}

model BookCopy {
  id         String     @id @default(cuid())
  book       Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String
  copyCode   String     @unique
  status     CopyStatus @default(AVAILABLE)
  schoolId   String?
  loans      BookLoan[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([bookId])
  @@index([status])
  @@index([schoolId])
}

model BookLoan {
  id           String       @id @default(cuid())
  copy         BookCopy     @relation(fields: [copyId], references: [id], onDelete: Cascade)
  copyId       String
  borrowerType BorrowerType
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId    String?
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId    String?
  issuedAt     DateTime     @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  renewCount   Int          @default(0)
  status       LoanStatus   @default(ISSUED)
  fineAmount   Float        @default(0)
  finePaid     Boolean      @default(false)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([copyId])
  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

// ---------- Transport models ----------
model Driver {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  licenseNo String?   @unique
  address   String?
  schoolId  String?
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
}

model Vehicle {
  id           String        @id @default(cuid())
  regNumber    String        @unique
  type         VehicleType   @default(BUS)
  capacity     Int           @default(30)
  model        String?
  status       VehicleStatus @default(ACTIVE)
  driver       Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId     String?
  schoolId     String?
  routes       TransportRoute[]
  lastLat      Float?
  lastLng      Float?
  lastSeenAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([schoolId])
}

model TransportRoute {
  id           String       @id @default(cuid())
  name         String
  code         String
  fare         Float        @default(0)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId    String?
  schoolId     String?
  stops        RouteStop[]
  assignments  StudentTransport[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
}

model RouteStop {
  id           String         @id @default(cuid())
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId      String
  name         String
  sequence     Int            @default(0)
  pickupTime   String?
  lat          Float?
  lng          Float?
  assignments  StudentTransport[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([routeId])
}

model StudentTransport {
  id         String                    @id @default(cuid())
  student    Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  route      TransportRoute            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId    String
  stop       RouteStop?                @relation(fields: [stopId], references: [id], onDelete: SetNull)
  stopId     String?
  status     TransportAssignmentStatus @default(ACTIVE)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@unique([studentId, routeId])
  @@index([routeId])
}

// ---------- Hostel models ----------
model HostelBuilding {
  id        String       @id @default(cuid())
  name      String
  gender    Gender?
  warden    String?
  address   String?
  schoolId  String?
  rooms     HostelRoom[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model HostelRoom {
  id          String             @id @default(cuid())
  building    HostelBuilding     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId  String
  roomNo      String
  capacity    Int                @default(4)
  monthlyFee  Float              @default(0)
  status      RoomStatus         @default(AVAILABLE)
  allocations HostelAllocation[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([buildingId, roomNo])
  @@index([status])
}

model HostelAllocation {
  id          String           @id @default(cuid())
  room        HostelRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  allocatedAt DateTime         @default(now())
  vacatedAt   DateTime?
  status      AllocationStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([roomId])
  @@index([studentId])
}

// ---------- SMS models ----------
model SmsTemplate {
  id        String        @id @default(cuid())
  name      String
  category  SmsCategory   @default(GENERAL)
  body      String
  schoolId  String?
  messages  SmsMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([schoolId, name])
  @@index([category])
  @@index([schoolId])
}

model SmsMessage {
  id             String         @id @default(cuid())
  title          String?
  body           String
  category       SmsCategory    @default(GENERAL)
  audience       SmsAudience    @default(CUSTOM)
  status         SmsStatus      @default(DRAFT)
  template       SmsTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId     String?
  provider       String?
  sentAt         DateTime?
  schoolId       String?
  recipients     SmsRecipient[]
  totalCount     Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  deliveredCount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([category])
  @@index([schoolId])
}

model SmsRecipient {
  id            String     @id @default(cuid())
  message       SmsMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId     String
  name          String?
  phone         String
  status        SmsStatus  @default(QUEUED)
  error         String?
  attempts      Int        @default(0)
  lastAttemptAt DateTime?
  providerRef   String?
  deliveredAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([messageId])
  @@index([status])
}

// ---------- Admissions models ----------
model AdmissionSession {
  id           String        @id @default(cuid())
  name         String
  year         Int
  classApplied String?
  startDate    DateTime?
  endDate      DateTime?
  seats        Int           @default(0)
  admissionFee Float         @default(0)
  isOpen       Boolean       @default(true)
  schoolId     String?
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Application {
  id             String            @id @default(cuid())
  session        AdmissionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  applicantName  String
  dateOfBirth    DateTime?
  gender         Gender?
  guardianName   String?
  guardianPhone  String?
  email          String?
  address        String?
  previousSchool String?
  classApplied   String?
  score          Float             @default(0)
  status         ApplicationStatus @default(SUBMITTED)
  note           String?
  photoUrl       String?
  birthCertUrl   String?
  transcriptUrl  String?
  admitRoll      String?
  trackingCode   String?           @unique
  schoolId       String?
  appliedAt      DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([schoolId])
}

// ---------- Risk Assessment model ----------
model RiskAssessment {
  id             String    @id @default(cuid())
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  score          Float     @default(0)
  level          RiskLevel @default(LOW)
  attendanceRate Float?
  duesAmount     Float?
  avgResult      Float?
  factors        String?
  computedAt     DateTime  @default(now())
  schoolId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([studentId])
  @@index([level])
  @@index([schoolId])
}

// ---------- Parent Portal: routine, homework, messaging, leave ----------
enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model RoutineSlot {
  id         String   @id @default(cuid())
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId    String
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId  String?
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId  String?
  teacher    Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId  String?
  day        WeekDay
  startTime  String
  endTime    String
  room       String?
  schoolId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([classId])
  @@index([sectionId])
  @@index([schoolId])
}

model Homework {
  id            String   @id @default(cuid())
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId       String
  section       Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId     String?
  teacher       Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId     String?
  title         String
  details       String
  attachmentUrl String?
  assignedOn    DateTime @default(now())
  dueDate       DateTime
  schoolId      String?
  submissions   HomeworkSubmission[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([classId])
  @@index([dueDate])
  @@index([schoolId])
}

model HomeworkSubmission {
  id         String                  @id @default(cuid())
  homework   Homework                @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  homeworkId String
  student    Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  content    String?
  fileUrl    String?
  fileName   String?
  status     HomeworkSubmissionStatus @default(SUBMITTED)
  submittedAt DateTime               @default(now())
  marks      Float?
  totalMarks Float                   @default(100)
  feedback   String?
  gradedAt   DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
}

enum MessageSender {
  PARENT
  TEACHER
  ADMIN
}

model ParentMessage {
  id         String        @id @default(cuid())
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  teacher    Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId  String?
  sender     MessageSender
  body       String
  readAt     DateTime?
  schoolId   String?
  createdAt  DateTime      @default(now())

  @@index([studentId])
  @@index([teacherId])
  @@index([schoolId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  fromDate   DateTime
  toDate     DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  reviewNote String?
  schoolId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([schoolId])
}

model Certificate {
  id            String            @id @default(cuid())
  certificateNo String            @unique
  type          CertificateType
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  studentName   String
  className     String?
  sectionName   String?
  rollNumber    String?
  dateOfBirth   DateTime?
  guardianName  String?
  admissionDate DateTime?
  payload       Json?
  examId        String?
  examName      String?
  issueDate     DateTime          @default(now())
  issuedBy      String?
  issuedByTitle String?
  signatureUrl  String?
  token         String            @unique
  status        CertificateStatus @default(ISSUED)
  revokedAt     DateTime?
  revokedReason String?
  hash          String?
  schoolId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([studentId])
  @@index([type])
  @@index([schoolId])
}

model Setting {
  id           String   @id @default(cuid())
  schoolId     String?
  organization Organization? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolName   String   @default("Greenwood International School")
  email        String   @default("info@greenwood.edu")
  phone        String   @default("+1 555 0100")
  address      String   @default("123 Education Blvd")
  logo         String?
  academicYear String   @default("2025-2026")
  schoolStartTime      String @default("08:30")
  lateThresholdMinutes Int    @default(10)
  attendanceSmsEnabled Boolean @default(true)
  principalName  String?
  principalTitle String @default("Principal")
  signatureUrl   String?
  // White-label
  theme          Json?
  customCss      String?
  updatedAt    DateTime @updatedAt

  @@unique([schoolId])
  @@index([schoolId])
}

// ---------- Online Examination ----------
model Question {
  id           String       @id @default(cuid())
  subject      Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId    String?
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId    String?
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId      String?
  type         QuestionType
  text         String
  options      Json?
  correctOption Int?
  modelAnswer  String?
  marks        Float        @default(1)
  explanation  String?
  tags         String?
  schoolId     String?
  examLinks    OnlineExamQuestion[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([subjectId])
  @@index([classId])
  @@index([type])
  @@index([schoolId])
}

model OnlineExam {
  id              String           @id @default(cuid())
  title           String
  class           Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId         String?
  section         Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId       String?
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId       String?
  teacher         Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId       String?
  description     String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int              @default(60)
  totalMarks      Float            @default(100)
  passMark        Float?
  negativeMark    Float            @default(0)
  shuffleQuestions Boolean         @default(false)
  status          OnlineExamStatus @default(DRAFT)
  schoolId        String?
  questions       OnlineExamQuestion[]
  attempts        ExamAttempt[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([classId])
  @@index([status])
  @@index([schoolId])
}

model OnlineExamQuestion {
  id          String     @id @default(cuid())
  exam        OnlineExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId      String
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  order       Int        @default(0)
  marks       Float      @default(1)
  answers     ExamAnswer[]

  @@unique([examId, questionId])
  @@index([examId])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  exam        OnlineExam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId      String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  status      AttemptStatus @default(IN_PROGRESS)
  score       Float         @default(0)
  rank        Int?
  answers     ExamAnswer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model ExamAnswer {
  id             String             @id @default(cuid())
  attempt        ExamAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId      String
  questionLink   OnlineExamQuestion @relation(fields: [questionLinkId], references: [id], onDelete: Cascade)
  questionLinkId String
  selectedOption Int?
  writtenAnswer  String?
  attachmentUrl  String?
  awardedMarks   Float    @default(0)
  isCorrect      Boolean?
  gradedAt       DateTime?

  @@unique([attemptId, questionLinkId])
  @@index([attemptId])
}
